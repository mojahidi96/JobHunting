# Copy to backend/.env and fill in. Never commit .env.
NODE_ENV=development            # development | test | production
PORT=4000
# Comma-separated browser origins allowed to call the API (https only in production).
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string for the dedicated JobHunting project/database.
# Replace <user>, <password> and <cluster-host>; keep the database name "jobhunting" (or your own).
# Use a separate database (e.g. jobhunting_dev / jobhunting_prod) per environment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/jobhunting?retryWrites=true&w=majority&appName=JobHunting

# 32 random bytes, base64. Encrypts sender app passwords at rest. Losing it invalidates saved sender credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Private directory for profile photos (never served statically). Keep outside the web root.
UPLOAD_DIR=./uploads

# Optional tuning (defaults shown). Client-supplied delays are clamped to the MIN/MAX bounds.
# Session policy (server-enforced). Idle = days without real use; max = absolute lifetime, never extended.
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=7
# DEFAULT_DELAY_MIN_MS=45000
# DEFAULT_DELAY_MAX_MS=90000
# MIN_DELAY_BOUND_MS=30000
# MAX_DELAY_BOUND_MS=300000
# COOKIE_SECURE=false           # forced true when NODE_ENV=production

# Where the browser returns after Google sign-in (the UI origin). Defaults to the first CORS_ORIGIN.
# FRONTEND_URL=http://localhost:5173

# --- Google sign-in (optional; the button is disabled until all three are set) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI exactly. In dev the Vite proxy makes this same-origin:
#   http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Application owner / roles ---
# The only account that can promote/demote Admins and configure email delivery. Bootstrapped server-side, and only once this
# exact address is VERIFIED (signed in with Google or an emailed code). Public registration can never grant Admin.
OWNER_EMAIL=you@example.com

# Per-user cap on messages queued in any rolling 24h window (abuse / relay prevention). Default 200.
# DAILY_SEND_LIMIT=200
# Candidates connect Gmail via OAuth ("Connect Gmail"); the Gmail App Password sender is OFF unless you set this to true.
# ENABLE_APP_PASSWORD_SENDER=false

# --- Transactional SMTP for login OTP emails ---
# EITHER set these variables OR let the owner enter the same details in the app (Admin > Email delivery), where the password
# is encrypted at rest with ENCRYPTION_KEY. Settings saved in the app take precedence over these variables.
# Provider examples (all speak SMTP):
#   Resend:   host smtp.resend.com  port 465 secure  user "resend"   pass <API key>
#   SES:      host email-smtp.<region>.amazonaws.com port 465 user <SMTP user> pass <SMTP password>
#   Postmark: host smtp.postmarkapp.com port 587 (AUTH_SMTP_SECURE=false) user/pass <server token>
#   SendGrid: host smtp.sendgrid.net port 465 user "apikey" pass <API key>
#   Gmail (testing only): host smtp.gmail.com port 465 user <you@gmail.com> pass <16-char App Password>
# A dedicated sender for authentication mail (e.g. Postmark/SES/Resend/Mailgun SMTP or a no-reply mailbox).
# This is NOT a user's outreach account and is never used for recruiter emails.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM="JobHunting <no-reply@your-domain.example>"
